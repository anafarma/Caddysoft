# Authentication (Clerk / Vercel Marketplace)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database (Postgres)
DATABASE_URL=

# Provider credentials are server-side only.
# A provider_accounts.credentialRef such as GOOGLE_MAIN maps to:
# CADDYSOFT_CREDENTIAL_GOOGLE_MAIN=<secret>
# Never put provider secrets in Git or ordinary database fields.
CADDYSOFT_CREDENTIAL_GOOGLE_MAIN=

# Vercel Cron authentication
CRON_SECRET=
